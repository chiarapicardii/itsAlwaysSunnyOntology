@prefix : <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#> .
@prefix dul: <http://www.loa-cnr.it/ontologies/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sunny: <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#> .
@base <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl> .

<https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl> rdf:type owl:Ontology ;
    owl:imports <http://www.loa-cnr.it/ontologies/DUL.owl> ;
    rdfs:comment "itsAlwaysSunnyOntology per KRKE 2026 - UNIBO" .

#################################################################
#    Object Properties
#################################################################

dul:isDescribedBy owl:equivalentProperty sunny:isDescribedBy .

sunny:describes rdf:type owl:ObjectProperty ;
                owl:inverseOf sunny:isDescribedBy .

sunny:hasAgent rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf dul:hasParticipant ;
               owl:inverseOf sunny:isAgentIn ;
               rdfs:domain sunny:HumorousSituation ;
               rdfs:range sunny:Agent .

sunny:hasQuality rdf:type owl:ObjectProperty ;
                 rdfs:domain sunny:HumorEntity ;
                 rdfs:range sunny:HumorQuality .

sunny:hasTarget rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dul:hasParticipant ;
                owl:inverseOf sunny:isTargetIn ;
                rdfs:domain sunny:HumorousSituation ;
                rdfs:range sunny:Target .

sunny:includesDescription rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf dul:hasComponent ;
                          rdfs:domain sunny:HumorousFrame .

sunny:includesSituation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dul:hasComponent ;
                        rdfs:domain sunny:HumorousSituation .

sunny:isDescribedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain sunny:Situation ;
                    rdfs:range sunny:Description .

sunny:violates rdf:type owl:ObjectProperty ;
               rdfs:domain sunny:SubversiveOccurence ;
               rdfs:range sunny:NormOccurence .

#################################################################
#    Individuals — Characters & Qualities
#################################################################

sunny:BehavioralQuality rdf:type owl:NamedIndividual .
sunny:PhysicalQuality rdf:type owl:NamedIndividual .

sunny:Charlie rdf:type owl:NamedIndividual , sunny:Agent , sunny:Target ;
              sunny:hasQuality sunny:BehavioralQuality ;
              rdfs:label "Charlie" .

sunny:Dee rdf:type owl:NamedIndividual , sunny:Agent , sunny:Target ;
          sunny:hasQuality sunny:BehavioralQuality ;
          rdfs:label "Dee" .

sunny:Dennis rdf:type owl:NamedIndividual , sunny:Agent , sunny:Target ;
             sunny:hasQuality sunny:BehavioralQuality ;
             rdfs:label "Dennis" .

sunny:Mac rdf:type owl:NamedIndividual , sunny:Agent , sunny:Target ;
          sunny:hasQuality sunny:BehavioralQuality ;
          rdfs:label "Mac" .

sunny:Gang rdf:type owl:NamedIndividual , sunny:Agent ;
           sunny:hasQuality sunny:BehavioralQuality .

#################################################################
#    Individuals — Populated Scenes (HS_001 - HS_010)
#################################################################

### SCENE 001
sunny:HS_001 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Dee , sunny:Mac ;
             sunny:hasTarget sunny:Lifeguard ;
             sunny:includesSituation sunny:HS_001_norm , sunny:HS_001_subversive ;
             sunny:isDescribedBy sunny:HS_001_frame ;
             sunny:isExplainedBy sunny:HS_001_mechanism ;
             sunny:hasTitle "The Gang Goes to a Water Park" .

sunny:HS_001_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_SafetyCompliance ;
                  rdfs:comment "Mac and Dee should respect the lifeguard's instructions." .

sunny:HS_001_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_ChildishRebellion ;
                        sunny:violates sunny:HS_001_norm ;
                        rdfs:comment "Mac and Dee force their way down the slide and get stuck." .

### SCENE 002
sunny:HS_002 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Dee , sunny:Gang ;
             sunny:hasTarget sunny:The_Therapist ;
             sunny:includesSituation sunny:HS_002_norm , sunny:HS_002_subversive ;
             sunny:isDescribedBy sunny:HS_002_frame ;
             sunny:isExplainedBy sunny:HS_002_mechanism ;
             sunny:hasTitle "The Gang Gets Analyzed" .

sunny:HS_002_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_ClinicalBoundaries ;
                  rdfs:comment "Dee should work on her growth alone." .

sunny:HS_002_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_TherapyTrivialization ;
                        sunny:violates sunny:HS_002_norm ;
                        rdfs:comment "Frank dumps dirty dishes on the therapist's floor." .

### SCENE 003
sunny:HS_003 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Dennis , sunny:Mac ;
             sunny:hasTarget <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Wally_(The_Neighbor)> ;
             sunny:includesSituation sunny:HS_003_norm , sunny:HS_003_subversive ;
             sunny:isDescribedBy sunny:HS_003_frame ;
             sunny:isExplainedBy sunny:HS_003_mechanism ;
             sunny:hasTitle "Mac & Dennis Move to the Suburbs" .

sunny:HS_003_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_NeighborlyEtiquette ;
                  rdfs:comment "They should exchange polite pleasantries." .

sunny:HS_003_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_HostileParanoia ;
                        sunny:violates sunny:HS_003_norm ;
                        rdfs:comment "Mac and Dennis stare aggressively in dead silence." .

### SCENE 004
sunny:HS_004 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Charlie ;
             sunny:hasTarget sunny:Dennis , sunny:Mac ;
             sunny:includesSituation sunny:HS_004_norm , sunny:HS_004_subversive ;
             sunny:isDescribedBy sunny:HS_004_frame ;
             sunny:isExplainedBy sunny:HS_004_mechanism ;
             sunny:hasTitle "The Waitress Is Getting Married" .

sunny:HS_004_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_SocialRelatability ;
                  rdfs:comment "Charlie should provide normal answers like 'traveling'." .

sunny:HS_004_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_BizarreUnrelatability ;
                        sunny:violates sunny:HS_004_norm ;
                        rdfs:comment "Charlie answers with 'milk steak', 'magnets', and 'ghouls'." .

### SCENE 005
sunny:HS_005 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Charlie , sunny:Mac ;
             sunny:hasTarget sunny:The_Kids ;
             sunny:includesSituation sunny:HS_005_norm , sunny:HS_005_subversive ;
             sunny:isDescribedBy sunny:HS_005_frame ;
             sunny:isExplainedBy sunny:HS_005_mechanism ;
             sunny:hasTitle "The Gang Gets New Wheels" .

sunny:HS_005_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_ProtectionOfMinors ;
                  rdfs:comment "They should confront the father or call the police." .

sunny:HS_005_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_DisplacedCowardice ;
                        sunny:violates sunny:HS_005_norm ;
                        rdfs:comment "They brutally beat up the thief's young children." .

### SCENE 006
sunny:HS_006 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Charlie ;
             sunny:hasTarget sunny:Mac ;
             sunny:includesSituation sunny:HS_006_norm , sunny:HS_006_subversive ;
             sunny:isDescribedBy sunny:HS_006_frame ;
             sunny:isExplainedBy sunny:HS_006_mechanism ;
             sunny:hasTitle "Charlie Catches a Leprechaun" .

sunny:HS_006_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_SelfPreservation ;
                  rdfs:comment "Charlie should use safe food coloring." .

sunny:HS_006_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_ToxicConsumption ;
                        sunny:violates sunny:HS_006_norm ;
                        rdfs:comment "Charlie drinks industrial toxic paint himself." .

### SCENE 007
sunny:HS_007 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Charlie_Mom ;
             sunny:hasTarget sunny:Charlie , sunny:The_Fundraiser_Crowd ;
             sunny:includesSituation sunny:HS_007_norm , sunny:HS_007_subversive ;
             sunny:isDescribedBy sunny:HS_007_frame ;
             sunny:isExplainedBy sunny:HS_007_mechanism ;
             sunny:hasTitle "Charlie's Mom Has Cancer" .

sunny:HS_007_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_MedicalHonesty ;
                  rdfs:comment "She should never fake a terminal illness." .

sunny:HS_007_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_FakedIllness ;
                        sunny:violates sunny:HS_007_norm ;
                        rdfs:comment "Admits she made up the cancer just for attention." .

### SCENE 008
sunny:HS_008 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Dee_HS008 ;
             sunny:hasTarget sunny:The_Comedy_Club_Audience ;
             sunny:includesSituation sunny:HS_008_norm , sunny:HS_008_subversive ;
             sunny:isDescribedBy sunny:HS_008_frame ;
             sunny:isExplainedBy sunny:HS_008_mechanism ;
             sunny:hasTitle "Dennis Reynolds: An Erotic Life" .

sunny:HS_008_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_PerformanceComposure ;
                  rdfs:comment "Dee should tell her rehearsed jokes smoothly." .

sunny:HS_008_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_BodilyPanic ;
                        sunny:violates sunny:HS_008_norm ;
                        rdfs:comment "Dee dry heaves loudly into the microphone." .

### SCENE 009
sunny:HS_009 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Dennis ;
             sunny:hasTarget sunny:Dee ;
             sunny:includesSituation sunny:HS_009_norm , sunny:HS_009_subversive ;
             sunny:isDescribedBy sunny:HS_009_frame ;
             sunny:isExplainedBy sunny:HS_009_mechanism ;
             sunny:hasTitle "Mac and Dennis Break Up" .

sunny:HS_009_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_PersonalIndependence ;
                  rdfs:comment "Dennis should peel the apple himself." .

sunny:HS_009_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_InfantileCodependency ;
                        sunny:violates sunny:HS_009_norm ;
                        rdfs:comment "Throws a screaming tantrum when she refuses to peel it." .

### SCENE 010
sunny:HS_010 rdf:type owl:NamedIndividual , sunny:HumorousSituation ;
             sunny:hasAgent sunny:Charlie , sunny:Mac ;
             sunny:hasTarget sunny:Dee , sunny:Dennis ;
             sunny:includesSituation sunny:HS_010_norm , sunny:HS_010_subversive ;
             sunny:isDescribedBy sunny:HS_010_frame ;
             sunny:isExplainedBy sunny:HS_010_mechanism ;
             sunny:hasTitle "Dennis and Dee Go on Welfare" .

sunny:HS_010_norm rdf:type sunny:NormOccurence ;
                  sunny:isDescribedBy sunny:ER_CompassionAndSupport ;
                  rdfs:comment "They should express shock and offer rehab help." .

sunny:HS_010_subversive rdf:type sunny:SubversiveOccurence ;
                        sunny:isDescribedBy sunny:SubF_CruelApathy ;
                        sunny:violates sunny:HS_010_norm ;
                        rdfs:comment "They laugh and pantomime them crying for crack." .

#################################################################
#    Theoretical Mechanisms & Frames (Setup)
#################################################################

sunny:HS_010_mechanism rdf:type sunny:SuperiorityTheory .
sunny:HS_010_frame rdf:type sunny:HumorousFrame ;
                   sunny:includesDescription sunny:ER_CompassionAndSupport , sunny:SubF_CruelApathy .
