@prefix : <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#> .
@prefix dul: <http://www.loa-cnr.it/ontologies/DUL.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sunny: <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#> .
@base <https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl> .

<https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl> rdf:type owl:Ontology ;
                                                                                                 owl:imports <http://www.loa-cnr.it/ontologies/DUL.owl> ;
                                                                                                 rdfs:comment "itsAlwaysSunnyOntology url: \"https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl\"" .

#################################################################
#    Object Properties
#################################################################

###  http://www.loa-cnr.it/ontologies/DUL.owl#isDescribedBy
dul:isDescribedBy owl:equivalentProperty sunny:isDescribedBy .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#describes
sunny:describes rdf:type owl:ObjectProperty ;
                owl:inverseOf sunny:isDescribedBy .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasAgent
sunny:hasAgent rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf dul:hasParticipant ;
               owl:inverseOf sunny:isAgentIn ;
               rdfs:domain sunny:HumorousSituation ;
               rdfs:range sunny:Agent .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasQuality
sunny:hasQuality rdf:type owl:ObjectProperty ;
                 rdfs:domain sunny:HumorEntity ;
                 rdfs:range sunny:HumorQuality ;
                 rdfs:comment "connecting HumorQuality to HumorEntity" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasTarget
sunny:hasTarget rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf dul:hasParticipant ;
                owl:inverseOf sunny:isTargetIn ;
                rdfs:domain sunny:HumorousSituation ;
                rdfs:range sunny:Target .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#includes
sunny:includes rdf:type owl:ObjectProperty ;
               owl:inverseOf sunny:isIncludedIn ;
               rdf:type owl:TransitiveProperty ;
               rdfs:comment "This is the shape to model the inclusion for the blending, but as i understood is not possibile to use the same property for D&S seeing that one is a construction of a patter and the other of the real application of it" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#includesDescription
sunny:includesDescription rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf dul:hasComponent ,
                                             sunny:includes ;
                          rdfs:domain sunny:HumorousFrame ;
                          rdfs:range sunny:EthicalRule ,
                                     sunny:ExpectedSocialFrame ,
                                     sunny:SubversiveFrame ;
                          rdfs:comment "All the elements that, blended, make the DescriptionFrame of the humor" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#includesSituation
sunny:includesSituation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf dul:hasComponent ,
                                           sunny:includes ;
                        rdfs:domain sunny:HumorousSituation ;
                        rdfs:range sunny:NormOccurence ,
                                   sunny:SubversiveOccurence ;
                        rdfs:comment "The actual application in the situation of the blending of the elements" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isAgentIn
sunny:isAgentIn rdf:type owl:ObjectProperty .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isDescribedBy
sunny:isDescribedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain sunny:Situation ;
                    rdfs:range sunny:Description ;
                    rdfs:comment "Important to connect the situations with the corresponding descriptions" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isExplainedBy
sunny:isExplainedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain sunny:HumorousSituation ;
                    rdfs:range sunny:TheoreticalMechanism .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isIncludedIn
sunny:isIncludedIn rdf:type owl:ObjectProperty .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isTargetIn
sunny:isTargetIn rdf:type owl:ObjectProperty .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isTriggeredBy
sunny:isTriggeredBy rdf:type owl:ObjectProperty ;
                    rdfs:domain sunny:TheoreticalMechanism ;
                    rdfs:range sunny:SubversiveOccurence ;
                    rdfs:comment "TheoreticalMechanism to Subversion" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#isViolatedBy
sunny:isViolatedBy rdf:type owl:ObjectProperty ;
                   owl:inverseOf sunny:violates .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#violates
sunny:violates rdf:type owl:ObjectProperty ;
               rdfs:domain sunny:SubversiveOccurence ;
               rdfs:range sunny:NormOccurence ;
               rdfs:comment "connecting SubversiveOccurrence to NormOccurence" .


#################################################################
#    Data properties
#################################################################

###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasDescription
sunny:hasDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain sunny:Situation ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Description of the scene" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasEpisodeNumber
sunny:hasEpisodeNumber rdf:type owl:DatatypeProperty ;
                       rdfs:domain sunny:Situation ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "Episode number with the season: for ex. S01E09" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasTimestamp
sunny:hasTimestamp rdf:type owl:DatatypeProperty ;
                   rdfs:domain sunny:Situation ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Where to find the specific moment" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#hasTitle
sunny:hasTitle rdf:type owl:DatatypeProperty ;
               rdfs:domain sunny:Situation ;
               rdfs:range xsd:string ;
               rdfs:comment "Title of the episode" .


#################################################################
#    Classes
#################################################################

###  http://www.loa-cnr.it/ontologies/DUL.owl#Description
dul:Description owl:equivalentClass sunny:Description .


###  http://www.loa-cnr.it/ontologies/DUL.owl#Situation
dul:Situation owl:equivalentClass sunny:Situation .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#AestheticQuality
sunny:AestheticQuality rdf:type owl:Class ;
                       rdfs:subClassOf sunny:HumorQuality ;
                       rdfs:comment "how they are dressed, how they appear" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Agent
sunny:Agent rdf:type owl:Class ;
            rdfs:subClassOf sunny:HumorEntity ;
            rdfs:comment "Who does the action" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#BehavioralQuality
sunny:BehavioralQuality rdf:type owl:Class ;
                        rdfs:subClassOf sunny:HumorQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Description
sunny:Description rdf:type owl:Class ;
                  owl:disjointWith sunny:Situation ;
                  rdfs:comment "The description part of all the frames converging to create the humorous situation" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#EthicalRule
sunny:EthicalRule rdf:type owl:Class ;
                  rdfs:subClassOf sunny:Description ;
                  rdfs:comment "the BEHAVIOURAL rules of the corresponding frame (Social decorum, professionalism, respect)" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ExpectedSocialFrame
sunny:ExpectedSocialFrame rdf:type owl:Class ;
                          rdfs:subClassOf sunny:Description ;
                          rdfs:comment "the normal social frame (a funeral, a job interview)" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#HumorEntity
sunny:HumorEntity rdf:type owl:Class ;
                  rdfs:subClassOf dul:SocialAgent .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#HumorQuality
sunny:HumorQuality rdf:type owl:Class ;
                   rdfs:subClassOf dul:Quality ;
                   rdfs:comment "This make the blend possibile: through this precise actions the character make the breaking of the social norm funny" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#HumorousFrame
sunny:HumorousFrame rdf:type owl:Class ;
                    rdfs:subClassOf sunny:Description ;
                    rdfs:comment "This is the BLENDING class, keeping all the descriptions together" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#HumorousSituation
sunny:HumorousSituation rdf:type owl:Class ;
                        rdfs:subClassOf sunny:Situation ;
                        rdfs:comment "The situation BLENDING all the other situations (Social, Norm e Subversive)" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#IncongruityTheory
sunny:IncongruityTheory rdf:type owl:Class ;
                        rdfs:subClassOf sunny:TheoreticalMechanism .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#NormOccurence
sunny:NormOccurence rdf:type owl:Class ;
                    rdfs:subClassOf sunny:Situation ;
                    rdfs:comment "How the characters apply this norm realated to the frame" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#PhysicalQuality
sunny:PhysicalQuality rdf:type owl:Class ;
                      rdfs:subClassOf sunny:HumorQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ReliefTheory
sunny:ReliefTheory rdf:type owl:Class ;
                   rdfs:subClassOf sunny:TheoreticalMechanism .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Situation
sunny:Situation rdf:type owl:Class ;
                rdfs:comment "The real description of what happens in the episodes" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#SubversiveFrame
sunny:SubversiveFrame rdf:type owl:Class ;
                      rdfs:subClassOf sunny:Description ;
                      rdfs:comment "Important to note that this is the only element in the description without a corrisponding class in the SItuation, becaue this is just a throretical description of the - already distorted - context the characters live in. In this sense, the whole situation is just an explanation of what we are describing here" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#SubversiveOccurence
sunny:SubversiveOccurence rdf:type owl:Class ;
                          rdfs:subClassOf dul:Action ,
                                          sunny:Situation ;
                          rdfs:comment "The real act of subversion (what are the characters doing)" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#SuperiorityTheory
sunny:SuperiorityTheory rdf:type owl:Class ;
                        rdfs:subClassOf sunny:TheoreticalMechanism .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Target
sunny:Target rdf:type owl:Class ;
             rdfs:subClassOf sunny:HumorEntity ;
             rdfs:comment "The victim of the joke" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#TheoreticalMechanism
sunny:TheoreticalMechanism rdf:type owl:Class ;
                           rdfs:comment "This is related to the literature around the construction oh humor" .


#################################################################
#    Individuals
#################################################################

###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#BehavioralQuality
sunny:BehavioralQuality rdf:type owl:NamedIndividual .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Chalie_HS005
sunny:Chalie_HS005 rdf:type owl:NamedIndividual ,
                            sunny:Agent ;
                   sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie
sunny:Charlie rdf:type owl:NamedIndividual ,
                       sunny:Agent ,
                       sunny:Target ;
              sunny:hasQuality sunny:BehavioralQuality ;
              rdfs:label "Charlie" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie_HS004
sunny:Charlie_HS004 rdf:type owl:NamedIndividual ,
                             sunny:Agent ;
                    sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie_HS006
sunny:Charlie_HS006 rdf:type owl:NamedIndividual ,
                             sunny:Agent ;
                    sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie_HS007
sunny:Charlie_HS007 rdf:type owl:NamedIndividual ,
                             sunny:Target ;
                    sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie_HS010
sunny:Charlie_HS010 rdf:type owl:NamedIndividual ,
                             sunny:Agent ;
                    sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Charlie_Mom
sunny:Charlie_Mom rdf:type owl:NamedIndividual ,
                           sunny:Agent ;
                  sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee
sunny:Dee rdf:type owl:NamedIndividual ,
                   sunny:Agent ,
                   sunny:Target ;
          sunny:hasQuality sunny:BehavioralQuality ;
          rdfs:label "Dee" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee_HS001
sunny:Dee_HS001 rdf:type owl:NamedIndividual ,
                         sunny:Agent ;
                sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee_HS002
sunny:Dee_HS002 rdf:type owl:NamedIndividual ,
                         sunny:Agent ;
                sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee_HS008
sunny:Dee_HS008 rdf:type owl:NamedIndividual ,
                         sunny:Agent ;
                sunny:hasQuality sunny:PhysicalQuality ;
                rdfs:label "Dee" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee_HS009
sunny:Dee_HS009 rdf:type owl:NamedIndividual ,
                         sunny:Target ;
                sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dee_HS010
sunny:Dee_HS010 rdf:type owl:NamedIndividual ,
                         sunny:Target ;
                sunny:hasQuality sunny:PhysicalQuality ;
                rdfs:label "Dee" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dennis
sunny:Dennis rdf:type owl:NamedIndividual ,
                      sunny:Agent ,
                      sunny:Target ;
             sunny:hasQuality sunny:BehavioralQuality ;
             rdfs:label "Dennis" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dennis_HS003
sunny:Dennis_HS003 rdf:type owl:NamedIndividual ,
                            sunny:Agent ;
                   sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dennis_HS004
sunny:Dennis_HS004 rdf:type owl:NamedIndividual ,
                            sunny:Target ;
                   sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dennis_HS009
sunny:Dennis_HS009 rdf:type owl:NamedIndividual ,
                            sunny:Agent ;
                   sunny:hasQuality sunny:BehavioralQuality .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#Dennis_HS010
sunny:Dennis_HS010 rdf:type owl:NamedIndividual ,
                            sunny:Agent ;
                   sunny:hasQuality sunny:PhysicalQuality ;
                   rdfs:label "Dennis" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_ClinicalBoundaries
sunny:ER_ClinicalBoundaries rdf:type owl:NamedIndividual ,
                                     sunny:EthicalRule ;
                            rdfs:comment "A professional norm requiring the patient to use therapy for psychological healing and to respect the sanctity of the clinical space" ;
                            rdfs:label "Respect for Clinical Purpose and Boundaries" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_CompassionAndSupport
sunny:ER_CompassionAndSupport rdf:type owl:NamedIndividual ,
                                       sunny:EthicalRule ;
                              rdfs:comment "The ethical obligation to provide emotional support and intervention when a loved one confesses to a life-threatening problem like severe drug addiction" ;
                              rdfs:label "Compassion in Times of Crisis" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_MedicalHonesty
sunny:ER_MedicalHonesty rdf:type owl:NamedIndividual ,
                                 sunny:EthicalRule ;
                        rdfs:comment "A fundamental moral rule prohibiting individuals from faking terminal diseases to exploit others' empathy or steal charitable funds" ;
                        rdfs:label "Truthfulness Regarding Severe Illness" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_NeighborlyEtiquette
sunny:ER_NeighborlyEtiquette rdf:type owl:NamedIndividual ,
                                      sunny:EthicalRule ;
                             rdfs:comment "A social norm requiring individuals to acknowledge greetings, introduce themselves, and maintain a friendly demeanor with those living nearby" ;
                             rdfs:label "Good Neighbor Etiquette and Basic Politeness" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_PerformanceComposure
sunny:ER_PerformanceComposure rdf:type owl:NamedIndividual ,
                                       sunny:EthicalRule ;
                              rdfs:comment "The social expectation that a public performer maintains basic composure, speaks clearly, and attempts to entertain rather than displaying severe bodily distress" ;
                              rdfs:label "Theatrical Composure and Preparation" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_PersonalIndependence
sunny:ER_PersonalIndependence rdf:type owl:NamedIndividual ,
                                       sunny:EthicalRule ;
                              rdfs:comment "A social norm dictating that adults should not treat their peers as servants for trivial tasks or throw tantrums when denied" ;
                              rdfs:label "Personal Independence and Maturity" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_ProtectionOfMinors
sunny:ER_ProtectionOfMinors rdf:type owl:NamedIndividual ,
                                     sunny:EthicalRule ;
                            rdfs:comment "An absolute ethical and legal norm stating that grown adults must never physically assault children, regardless of the circumstances or provocation" ;
                            rdfs:label "Protection of Minors from Adult Violence" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_SafetyCompliance
sunny:ER_SafetyCompliance rdf:type owl:NamedIndividual ,
                                   sunny:EthicalRule ;
                          rdfs:comment "A social norm requiring patrons to strictly follow age/size restrictions and respect designated staff instructions" ;
                          rdfs:label "Compliance with Safety Regulations" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_SelfPreservation
sunny:ER_SelfPreservation rdf:type owl:NamedIndividual ,
                                   sunny:EthicalRule ;
                          rdfs:comment " The universal human instinct and ethical responsibility to protect one's own body and others by not consuming or serving lethal toxins" ;
                          rdfs:label "Basic Self-Preservation and Health" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ER_SocialRelatability
sunny:ER_SocialRelatability rdf:type owl:NamedIndividual ,
                                     sunny:EthicalRule ;
                            rdfs:comment "The expectation that one should present understandable and socially acceptable traits to be perceived as an attractive and safe partner" ;
                            rdfs:label "Relatability and Social Appeal in Dating" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_AdultSelfSufficiency
sunny:ESF_AdultSelfSufficiency rdf:type owl:NamedIndividual ,
                                        sunny:ExpectedSocialFrame ;
                               rdfs:comment "The social expectation that a grown adult is capable of preparing and eating basic foods, like an apple, without assistance" ;
                               rdfs:label "Basic Adult Self-Sufficiency" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_CharityFundraiser
sunny:ESF_CharityFundraiser rdf:type owl:NamedIndividual ,
                                     sunny:ExpectedSocialFrame ;
                            rdfs:comment "A social gathering designed to elicit empathy and collect financial donations to help someone facing a severe tragedy or illness" ;
                            rdfs:label "Charity Fundraiser Event" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_CloseFriendship
sunny:ESF_CloseFriendship rdf:type owl:NamedIndividual ,
                                   sunny:ExpectedSocialFrame ;
                          rdfs:comment "A social bond between close friends where mutual support, empathy, and help are expected during times of severe personal crisis" ;
                          rdfs:label "Close Friendship and Mutual Support" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_DisputeResolution
sunny:ESF_DisputeResolution rdf:type owl:NamedIndividual ,
                                     sunny:ExpectedSocialFrame ;
                            rdfs:comment "A social situation where mature adults resolve conflicts or thefts through verbal negotiation, law enforcement, or direct confrontation with the responsible party" ;
                            rdfs:label "Adult Dispute Resolution" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_FoodAndBeverageSafety
sunny:ESF_FoodAndBeverageSafety rdf:type owl:NamedIndividual ,
                                         sunny:ExpectedSocialFrame ;
                                rdfs:comment "A baseline commercial and personal standard where consumable items must be non-toxic, and individuals avoid ingesting deadly chemicals" ;
                                rdfs:label "Food and Beverage Safety Standards" .


###  https://github.com/chiarapicardii/itsAlwaysSunnyOntology/blob/main/itsAlwaysSunnyOntology.ttl#ESF_OnlineDatingProfile
sunny:ESF_OnlineDatingProfile rdf:type owl:NamedIndividual ,
                                       sunny:ExpectedSocialFrame ;
